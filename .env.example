FAILURELAB_DATA_DIR=var
FAILURELAB_HOST=127.0.0.1
FAILURELAB_PORT=8787
# baseline is an explicitly labeled deterministic diagnostic baseline, not an LLM.
FAILURELAB_MODEL_MODE=baseline
# Use chat for a real text/vision model through Hugging Face or a compatible gateway.
FAILURELAB_MODEL_BASE_URL=https://router.huggingface.co/v1
FAILURELAB_MODEL_NAME=Qwen/Qwen3-235B-A22B-Instruct-2507:novita
FAILURELAB_MODEL_API_KEY=
# Enable only when the selected model accepts image content.
FAILURELAB_MODEL_VISION=false
# Optional real local dense embeddings + cross-encoder reranking: uv sync --extra ml
FAILURELAB_RETRIEVAL_MODE=lexical
FAILURELAB_EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
FAILURELAB_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
FAILURELAB_GITHUB_TOKEN=
FAILURELAB_WEBHOOK_SECRET=
# Comma separated owner/repo names permitted for ingestion and webhooks.
FAILURELAB_GITHUB_REPOSITORIES=
# Required when binding outside loopback. Frontend asks for this token.
FAILURELAB_API_TOKEN=
FAILURELAB_SEED_DEMO=true
FAILURELAB_WORKER_ENABLED=true
# Optional remote runner must implement docs/runner-protocol.md in an isolated VM.
FAILURELAB_RUNNER_URL=
FAILURELAB_RUNNER_TOKEN=
# Optional, otherwise SQLite in DATA_DIR. See docs/deployment.md for PostgreSQL.
FAILURELAB_DATABASE_URL=
# Optional token pricing for estimated model cost; absent prices remain unknown.
FAILURELAB_INPUT_USD_PER_MILLION=
FAILURELAB_OUTPUT_USD_PER_MILLION=
